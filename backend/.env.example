# Copy to .env and fill in the required values. Never commit the real .env.

# Required. Replace each <placeholder> with a real value in your .env.
DATABASE_URL=<postgresql-connection-string>
SESSION_SECRET=<generate-32-plus-random-chars>
PIN_LOOKUP_SECRET=<generate-32-plus-random-hex-chars>

# Optional (defaults shown)
NODE_ENV=development
PORT=4000
# Loopback by default: the Next.js proxy is the only LAN-facing service.
API_HOST=127.0.0.1
TZ=UTC
SESSION_COOKIE_NAME=rfs_session
SESSION_TTL_HOURS=12
CORS_ORIGIN=http://localhost:3000
ATTACHMENTS_ROOT=./storage/attachments
BACKUP_LOCAL_PATH=./storage/backups

# Seed (used by prisma:seed for the initial OWNER)
SEED_OWNER_USERNAME=owner
SEED_OWNER_PASSWORD=<your-owner-password>
SEED_OWNER_FULLNAME=System Owner
SEED_OWNER_PHONE=
