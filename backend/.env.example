# Copy to .env and fill in the required values. Never commit the real .env.

# Required
DATABASE_URL=postgresql://user:password@localhost:5432/rfs
SESSION_SECRET=replace-with-32-plus-random-chars
PIN_LOOKUP_SECRET=replace-with-32-plus-random-hex-chars

# Optional (defaults shown)
NODE_ENV=development
PORT=4000
TZ=UTC
SESSION_COOKIE_NAME=rfs_session
SESSION_TTL_HOURS=12
CORS_ORIGIN=http://localhost:3000
ATTACHMENTS_ROOT=./storage/attachments
BACKUP_LOCAL_PATH=./storage/backups

# Seed (used by prisma:seed for the initial OWNER)
SEED_OWNER_USERNAME=owner
SEED_OWNER_PASSWORD=replace-with-12-plus-chars
SEED_OWNER_FULLNAME=System Owner
SEED_OWNER_PHONE=
