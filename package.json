{
    "name": "restaurant-financial-system",
    "private": true,
    "version": "0.1.0",
    "packageManager": "pnpm@9.15.9",
    "engines": {
        "node": ">=20.11.0"
    },
    "scripts": {
        "backend:dev": "pnpm --filter @rfs/backend dev",
        "backend:migrate": "pnpm --filter @rfs/backend prisma:migrate",
        "backend:seed": "pnpm --filter @rfs/backend prisma:seed",
        "backend:test": "pnpm --filter @rfs/backend test",
        "frontend:dev": "pnpm --filter @rfs/frontend dev",
        "electron:dev": "pnpm --filter @rfs/electron dev",
        "dev": "concurrently -n api,web -c blue,green \"pnpm backend:dev\" \"pnpm frontend:dev\"",
        "e2e": "playwright test",
        "e2e:headed": "playwright test --headed"
    },
    "devDependencies": {
        "@playwright/test": "^1.64.0",
        "concurrently": "^9.0.1",
        "playwright-core": "^1.63.0"
    }
}